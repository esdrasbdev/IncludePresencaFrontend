# Em desenvolvimento o Vite repassa /api para o backend (ver vite.config.ts), por isso a URL é relativa.
VITE_API_URL=/api

# Endereço do backend .NET (o proxy do Vite aponta para ele).
VITE_PROXY_TARGET=http://localhost:5045

# true = tudo com dados de exemplo (sem backend). Para ligar no backend real, use false.
VITE_USE_MOCKS=false

# O backend ainda NÃO tem os módulos de eventos, presenças, justificativas, relatórios nem listagem/edição de membros.
# true = essas telas continuam com dados de exemplo; login, ativação, recuperação de senha e criação de membro usam a API real.
# false = essas telas chamam a API (e mostram erro até o backend implementá-las).
VITE_MOCK_MODULOS_PENDENTES=true
