# Em desenvolvimento o Vite repassa /api para o backend (ver vite.config.ts), por isso a URL é relativa.
VITE_API_URL=/api

# Endereço do backend .NET (o proxy do Vite aponta para ele).
VITE_PROXY_TARGET=http://localhost:5045

# true = TUDO com dados de exemplo (sem backend). Para ligar no backend real, use false.
VITE_USE_MOCKS=false

# Com VITE_USE_MOCKS=false, EVENTOS e MEMBROS usam a API real (já existem no backend de identidade).
# Para voltar a ver dados de exemplo só nesses módulos: VITE_MOCK_EVENTOS=true / VITE_MOCK_MEMBROS=true.

# Check-in, frequência, justificativas e relatórios ainda não estão integrados (rotas assumidas).
# true = continuam com dados de exemplo; false = chamam a API (e mostram erro até existirem).
# Para escolher módulo a módulo: VITE_MOCK_PRESENCAS, VITE_MOCK_FREQUENCIA, VITE_MOCK_JUSTIFICATIVAS, VITE_MOCK_RELATORIOS.
VITE_MOCK_MODULOS_PENDENTES=true
